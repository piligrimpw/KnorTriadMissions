$grp LL_MissionDescription : "{4A2582FF7C761EAE}Prefabs/Map/LL_MissionDescription.et" {
 {
  coords 2632.743 170.243 7180.539
  m_sTitle "Вводные"
  m_sTextData "В ходе ужесточения внутренней национальной политики в республике Чернарусь накопленные противоречия местных властей и столицы выливаются в вооруженное восстание на периферии страны."\
  ""\
  "По данным разведки противник разграбил склады военного имущества и может располагать неизвестным количеством взрывчатки, в том числе противотанковыми и противопехотными минами."\
  ""\
  "Время суток: 10:15"\
  "Время на выполнение задачи: 60 минут"\
  "Погодные условия: Солнечно"
 }
 {
  coords 2643.89 170.303 7189.563
  m_sTitle "Задачи"
  m_sTextData "Подразделению ЧСО приказано овладеть стратегически важными перекрестками основных дорог западнее поселка Лоза."\
  "Для выполнения данной задачи необходимо:"\
  "1. Овладеть западным перекрестком. (<link=TriggerWestCheckpoint>точка 1</link>)."\
  "2. Овладеть восточным перекрестком. (<link=TriggerEastCheckpoint>точка 2</link>)."
  m_iOrder 1
  m_bShowForAnyFaction 0
  m_aVisibleForFactions {
   "CDF"
  }
 }
 {
  coords 2650.292 170.375 7198.313
  m_sTitle "Задачи"
  m_sTextData "Добровольческому отряду была поставлена задача закрепиться на перекрестках западнее поселка Лоза и воспрепятствовать проходу сил ЧСО."\
  ""\
  "Для выполнения данной задачи отряду добровольцев необходимо: "\
  "1. Удержать под контролем западный перекресток дорог. (точка 1)."\
  "2. Удержать под контролем восточный перекресток дорог. (точка 2)."
  m_iOrder 1
  m_bShowForAnyFaction 0
  m_aVisibleForFactions {
   "IMF"
  }
 }
 {
  coords 2638.475 170.32 7186.711
  m_sTitle "Перечень содержимого склада"
  m_sTextData "- 7 ящиков с БК для пехотного отделения"\
  "- 3 ящика с мешками с песком (по 100шт в каждом)"\
  "- 2 ящика с БК на агс17 (по 6 улиток в каждом)"\
  "- 1 ящик с взрывчаткой"\
  "- 10 набров для установки маск. сети"\
  "- 6 рулонов маск. сети"\
  "- 5 рпг22"\
  "- 20 тм62м"\
  ""
  m_iOrder 2
  m_bShowForAnyFaction 0
  m_aVisibleForFactions {
   "IMF"
  }
 }
 {
  coords 2641.1 170.367 7189.369
  m_sTitle "Игровые механики"
  m_sTextData "- С помощью набора для установки маскировочной сети вы можете установить маскировочную сеть, при добавлении 1-2 рулонов маскировочной сети вы сможете установить средние и большие версии."\
  ""\
  "- Мины можно привязывать к детонатору и ставить на взрыватель как тротиловые шашки."\
  ""\
  "- У рпг22 добавлен прицел на 100м (скм чтобы поменять на ванильный)."\
  ""\
  "- Ящики с бк можно перетаскивать в руках."
  m_iOrder 4
 }
 {
  coords 2644.86 169.875 7173.965
  m_sTitle "Условности миссии"
  m_sTextData "Запрещено блокировать входы в зонах захвата."\
  "Запрещено минировать входы в зонах захвата."
  m_iOrder 5
 }
}